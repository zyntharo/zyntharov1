# ---------------------------------------------------------------------------
# Vyralis environment template. Copy to `.env` (git-ignored) and fill in.
# Never commit real keys. The GUI can also store providers at runtime from
# Settings -> Providers, which writes to the encrypted local store instead.
# ---------------------------------------------------------------------------

# --- Primary frontier model provider (OpenAI-compatible endpoint) -----------
VYRALIS_PRIMARY_BASE_URL=https://api.openai.com/v1
VYRALIS_PRIMARY_API_KEY=
VYRALIS_PRIMARY_MODEL=gpt-4o
# Realtime / audio-live model used for the voice loop.
VYRALIS_PRIMARY_AUDIO_MODEL=gpt-4o-realtime-preview

# --- Secondary provider (used by the Manager agent as first fallback) -------
VYRALIS_SECONDARY_BASE_URL=https://api.anthropic.com/v1
VYRALIS_SECONDARY_API_KEY=
VYRALIS_SECONDARY_MODEL=claude-sonnet-4-5

# --- Local / offline provider (optional, e.g. ollama) -----------------------
VYRALIS_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
VYRALIS_LOCAL_MODEL=llama3.1:8b

# --- Server ------------------------------------------------------------------
VYRALIS_HOST=127.0.0.1
VYRALIS_PORT=8756
# Shared secret required by the GUI WebSocket/REST. Auto-generated if empty.
VYRALIS_TOKEN=

# --- Browser control ---------------------------------------------------------
# Which installed browser to drive. "chrome" | "msedge" | "chromium" | path
VYRALIS_BROWSER_CHANNEL=chrome
VYRALIS_BROWSER_HEADLESS=false
VYRALIS_BROWSER_PROFILE=default

# --- Hardware monitoring -----------------------------------------------------
# LibreHardwareMonitor / OpenHardwareMonitor WMI namespace is used on Windows
# when present. Optional HTTP bridge (LibreHardwareMonitor web server):
VYRALIS_LHM_URL=http://127.0.0.1:8085/data.json
VYRALIS_CPU_TEMP_WARN=80
VYRALIS_CPU_TEMP_CRIT=92
VYRALIS_MEM_PCT_WARN=88
VYRALIS_DISK_FREE_WARN_GB=5

# --- Safety ------------------------------------------------------------------
# ask | auto | deny. `ask` requires user confirmation for destructive actions.
VYRALIS_PERMISSION_MODE=ask
# Comma-separated directory allowlist for the filesystem tools.
VYRALIS_FS_ALLOWLIST=
